---
import Layout from '../layouts/Layout.astro';
import {
	Nav,
	Hero,
	About,
	Hability,
	Experience,
	Works,
	Red,
	Preguntas,
	Final,
} from '../components/componentsS';
import {
	getConfiguracionGlobal,
	getPerfil,
	getProyectos,
	getHabilidades,
	getPreguntasFrecuentes,
	getExperiencias,
} from '../service';

const [config, perfil, proyectos, habilidades, preguntas, experiencias] = await Promise.all([
	getConfiguracionGlobal().catch(() => null),
	getPerfil().catch(() => null),
	getProyectos().catch(() => []),
	getHabilidades().catch(() => []),
	getPreguntasFrecuentes().catch(() => []),
	getExperiencias().catch(() => []),
]);

const strapiData = {
	configuracionGlobal: config,
	perfil,
	proyectos,
	habilidades,
	preguntasFrecuentes: preguntas,
	experiencias,
};
---

<Layout>
	<Nav />
	<Hero />
	<About />
	<Experience experiencias={experiencias} />
	<Hability habilidades={habilidades} />
	<Works proyectos={proyectos} />
	<Final />

	<script is:inline define:vars={{ strapiData }}>
		console.log('🚀 [Strapi Data en Navegador]:', strapiData);
		console.log('📄 Perfil:', strapiData.perfil);
		console.log('💼 Proyectos:', strapiData.proyectos);
		console.log('⚡ Habilidades:', strapiData.habilidades);
		console.log('❓ Preguntas Frecuentes:', strapiData.preguntasFrecuentes);
		console.log('⚙️ Configuración Global:', strapiData.configuracionGlobal);
	</script>
</Layout>
