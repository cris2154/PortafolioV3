---
import { getConfiguracionGlobal, getMediaUrl, getPerfil } from '../../service';
import SocialIcon from './SocialIcon.astro';

const [perfil, config] = await Promise.all([getPerfil(), getConfiguracionGlobal()]);
const avatar = getMediaUrl(perfil.avatar_foto, 'thumbnail') || '/cris.png';
const redes = config.redes_sociales ?? [];
const correo = config.correo_contacto || 'Crishuamani023@gmail.com';

const nombre =
  config.nombre_sitio && config.nombre_sitio !== 'Portafolio Dev (datos de prueba)'
    ? config.nombre_sitio
    : 'Cristhian Huamani';
---

<section
  id="final"
  class="w-full bg-white flex flex-col justify-center items-center py-14 sm:py-20 lg:py-24 relative overflow-hidden"
>
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6">
    <!-- CONTENEDOR 2D IGUAL QUE EL ABOUT / HERO / EXPERIENCE -->
    <div
      class="final-container w-full bg-white rounded-3xl lg:rounded-[36px] border border-gray-100 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.06),0_1px_3px_rgba(0,0,0,0.02)] p-6 sm:p-10 lg:p-12 xl:p-14 relative"
    >
      
      <!-- BARRA SUPERIOR: Disponibilidad + Volver al inicio -->
      <div class="flex items-center justify-between flex-wrap gap-4 pb-8 mb-8 border-b border-gray-100">
        

        <a
          href="#top"
          class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 hover:text-orange-500 transition-colors group"
        >
          <span>Volver al inicio</span>
          <span class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 group-hover:bg-orange-500 group-hover:text-white transition-colors">
            <svg class="w-4 h-4 transition-transform group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0l-6 6m6-6l6 6"/>
            </svg>
          </span>
        </a>
      </div>

      <!-- CONTENIDO PRINCIPAL: Frase + WhatsApp a la izquierda, Perfil + Redes a la derecha -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- LADO IZQUIERDO: La gran frase y el botón de WhatsApp -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-gray-900 leading-[1.08] tracking-tight">
            Creemos<br />
            algo<br />
            extraordinario <br />
            juntos<span class="text-orange-500">.</span>
          </h2>

          <p class="text-gray-500 text-base sm:text-lg leading-relaxed max-w-lg">
            Vamos a generar un impacto real. Contáctame si buscas un servicio rápido, profesional y listo para darle vida a tus proyectos digitales.
          </p>

          <!-- BOTÓN DE WHATSAPP NARANJA -->
          <div class="pt-2 sm:pt-4">
            <a
              href="https://wa.me/51921554150"
              target="_blank"
              rel="noreferrer"
              class="cta-whatsapp group inline-flex items-center gap-3 bg-orange-500 hover:bg-orange-600 text-white font-bold px-7 sm:px-8 py-3.5 sm:py-4 rounded-full shadow-[0_12px_28px_-6px_rgba(249,115,22,0.42)] hover:shadow-[0_18px_32px_-6px_rgba(249,115,22,0.52)] transition-all hover:scale-105 active:scale-95 text-base sm:text-lg cursor-pointer"
            >
              <svg class="w-6 h-6 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>Escríbeme por WhatsApp</span>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.3" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- LADO DERECHO: Tarjeta de perfil, email y redes sociales -->
        <div class="final-profile-card lg:col-span-5 bg-gray-50/80 rounded-2xl sm:rounded-3xl p-6 sm:p-8 border border-gray-100 flex flex-col justify-between space-y-6">
          
          <!-- Avatar y Nombre -->
          <div class="flex items-center gap-4">
            <img
              src={avatar}
              alt={nombre}
              class="w-16 h-16 rounded-full border-2 border-orange-500 object-cover object-top shadow-sm bg-white shrink-0"
            />
            <div>
              <h3 class="text-xl font-bold text-gray-900">{nombre}</h3>
              <p class="text-sm font-semibold text-orange-500">Frontend Developer & UI/UX</p>
            </div>
          </div>

          <!-- Email -->
          <div class="space-y-1.5">
            <span class="text-xs uppercase tracking-wider font-semibold text-gray-400">Contáctame por email</span>
            <div>
              <a
                href={`mailto:${correo}`}
                class="final-email-link group inline-flex items-center gap-2 text-base sm:text-lg font-bold text-gray-900 hover:text-orange-500 transition-colors break-all"
              >
                <span>{correo}</span>
                <svg class="w-4 h-4 text-orange-500 transition-transform group-hover:translate-x-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Redes Sociales -->
          <div class="space-y-3 pt-4 border-t border-gray-200/80">
            <span class="text-xs uppercase tracking-wider font-semibold text-gray-400">Redes Sociales</span>
            <div id="final-socials" class="flex flex-wrap items-center gap-2.5">
              {redes.map((r) => (
                <a
                  href={r.url}
                  target={r.red === 'correo' ? undefined : '_blank'}
                  rel="noreferrer"
                  class="social-btn group inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-white hover:bg-orange-500 text-gray-700 hover:text-white border border-gray-200/90 hover:border-orange-500 transition-all duration-300 shadow-xs hover:shadow-sm"
                  aria-label={r.etiqueta ?? r.red}
                >
                  <SocialIcon red={r.red} class="w-4 h-4 transition-transform group-hover:scale-110" />
                  <span class="text-xs font-semibold capitalize">{r.etiqueta ?? r.red}</span>
                </a>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- FOOTER INFERIOR DENTRO DEL CONTENEDOR -->
      <div class="mt-12 pt-8 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-gray-400">
        <p>© {new Date().getFullYear()} {nombre} — Frontend Developer</p>
        <div class="flex items-center gap-3">
          <a href="#top" class="hover:text-orange-600 transition-colors">Volver al inicio</a>
          <span class="w-1 h-1 rounded-full bg-gray-300"></span>
          <a href={`mailto:${correo}`} class="hover:text-orange-600 transition-colors">{correo}</a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const finalContainer = document.querySelector(".final-container");
  if (finalContainer) {
    gsap.from(".final-container", {
      scrollTrigger: {
        trigger: "#final",
        start: "top 88%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      clearProps: "all",
    });
  }
</script>
