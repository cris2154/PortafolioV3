---
import { getPreguntasFrecuentes } from '../../service';
import { markdownLite } from '../../utils/text';

const preguntas = await getPreguntasFrecuentes();
---

<section class="py-24 faq-section bg-white text-[#111]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col justify-center items-center gap-x-16 gap-y-5 xl:gap-28 lg:flex-row lg:justify-between max-lg:max-w-2xl mx-auto max-w-full"
    >
      <div class="w-full lg:w-1/2">
        <img
          src="/shots.png"
          alt="FAQ sección"
          class="w-full rounded-xl object-cover shadow-sm"
        />
      </div>
      <div class="w-full lg:w-1/2">
        <div class="lg:max-w-xl">
          <div class="mb-6 lg:mb-16">
            <h2
              class="text-4xl text-center font-bold text-gray-900 mb-5 lg:text-left"
            >
              Preguntas Frecuentes
            </h2>
          </div>
          <div class="accordion-group" data-accordion="default-accordion">
            {preguntas.map((item, index) => (
              <div
                class={`accordion ${index === 0 ? 'pb-8 active' : 'py-8'} border-b border-solid border-gray-200`}
                id={`faq-item-${item.id}`}
              >
                <button
                  class="accordion-toggle group inline-flex items-center justify-between text-xl font-normal leading-8 text-gray-600 w-full transition duration-500 hover:text-green-500 accordion-active:text-green-500 accordion-active:font-medium"
                  aria-controls={`faq-collapse-${item.id}`}
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <h5 class="text-left font-medium text-gray-900">{item.pregunta}</h5>
                  <svg
                    class="shrink-0 ml-4 text-gray-900 transition duration-500 group-hover:text-green-500 accordion-active:text-green-500"
                    width="22"
                    height="22"
                    viewBox="0 0 22 22"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M16.5 8.25L12.4142 12.3358C11.7475 13.0025 11.4142 13.3358 11 13.3358C10.5858 13.3358 10.2525 13.0025 9.58579 12.3358L5.5 8.25"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
                <div
                  id={`faq-collapse-${item.id}`}
                  class={`accordion-content w-full px-0 overflow-hidden pr-4 ${index === 0 ? 'active' : ''}`}
                  style="max-height: 0px;"
                  aria-labelledby={`faq-item-${item.id}`}
                >
                  <div
                    class="text-base font-normal text-gray-600 space-y-2 mt-3 leading-relaxed"
                    set:html={markdownLite(item.respuesta)}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const accordionGroup = document.querySelector('[data-accordion="default-accordion"]');
    if (!accordionGroup) return;

    const accordions = accordionGroup.querySelectorAll('.accordion');

    const setAccordionState = (accordion, shouldOpen) => {
      const button = accordion.querySelector('.accordion-toggle');
      const content = accordion.querySelector('.accordion-content');

      accordion.classList.toggle('active', shouldOpen);

      if (button) {
        button.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
      }

      if (content) {
        content.style.maxHeight = shouldOpen ? `${content.scrollHeight}px` : '0px';
        content.classList.toggle('active', shouldOpen);
      }
    };

    accordions.forEach((accordion) => {
      const button = accordion.querySelector('.accordion-toggle');
      if (!button) return;

      button.addEventListener('click', () => {
        const isOpen = accordion.classList.contains('active');

        accordions.forEach((otherAccordion) => {
          if (otherAccordion !== accordion) {
            setAccordionState(otherAccordion, false);
          }
        });

        setAccordionState(accordion, !isOpen);
      });

      const defaultOpen = accordion.classList.contains('active');
      setAccordionState(accordion, defaultOpen);
    });
  });
</script>

<style>
  .faq-section .accordion-content {
    transition: max-height 0.45s ease, opacity 0.45s ease;
    opacity: 0;
  }

  .faq-section .accordion-content.active {
    opacity: 1;
  }

  .faq-section .accordion-toggle svg {
    transition: transform 0.45s ease, color 0.3s ease;
  }

  .faq-section .accordion.active .accordion-toggle svg {
    transform: rotate(180deg);
  }

  @media (max-width: 640px) {
    .faq-section {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .faq-section .accordion {
      padding: 1rem 0;
    }

    .faq-section .accordion-toggle {
      font-size: 1rem;
      line-height: 1.5rem;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .faq-section .accordion-toggle h5 {
      text-align: left;
    }

    .faq-section .accordion-content {
      padding-right: 0;
    }

    .faq-section .accordion-content p {
      font-size: 0.95rem;
      line-height: 1.5rem;
    }
  }
</style>
