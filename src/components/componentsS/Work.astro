                    <span>Visitar Demo / Proyecto</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
                {proyecto.enlace_repositorio && (
                  <a
                    href={proyecto.enlace_repositorio}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-gray-900 hover:bg-gray-800 text-white font-semibold text-sm transition-all hover:scale-105 active:scale-95 shadow-sm"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    <span>Ver Código en GitHub</span>
                  </a>
                )}
              </div>
            )}
          </div>

          <!-- Acerca del Proyecto -->
          {proyecto.acerca_del_proyecto && (
            <section class="max-w-2xl mx-auto w-full space-y-4 pt-2">
              <h2 class="text-xs uppercase tracking-widest font-bold text-gray-400">
                Acerca del Proyecto
              </h2>
              <div
                class="text-gray-700 text-lg sm:text-xl md:text-2xl font-normal leading-relaxed space-y-6 sm:space-y-8 [&_p]:text-gray-700 [&_p]:text-lg sm:[&_p]:text-xl md:[&_p]:text-2xl [&_p]:leading-relaxed [&_ul]:list-none [&_ul]:pl-0 [&_ul]:space-y-6 sm:[&_ul]:space-y-8 [&_li]:text-gray-700 [&_li]:text-lg sm:[&_li]:text-xl md:[&_li]:text-2xl [&_li]:leading-relaxed [&_strong]:text-gray-900 [&_strong]:font-semibold"
                set:html={markdownLite(proyecto.acerca_del_proyecto)}
              />
            </section>
          )}

          <!-- El Desafío (Texto grande, sin contenedor) -->
          {proyecto.el_desafio && (
            <section class="max-w-2xl mx-auto w-full space-y-4 pt-4">
              <h2 class="text-xs uppercase tracking-widest font-bold text-gray-400">
                El Desafío
              </h2>
              <div
                class="text-gray-700 text-lg sm:text-xl md:text-2xl font-normal leading-relaxed space-y-6 sm:space-y-8 [&_p]:text-gray-700 [&_p]:text-lg sm:[&_p]:text-xl md:[&_p]:text-2xl [&_p]:leading-relaxed [&_ul]:list-none [&_ul]:pl-0 [&_ul]:space-y-6 sm:[&_ul]:space-y-8 [&_li]:text-gray-700 [&_li]:text-lg sm:[&_li]:text-xl md:[&_li]:text-2xl [&_li]:leading-relaxed [&_strong]:text-gray-900 [&_strong]:font-semibold"
                set:html={markdownLite(proyecto.el_desafio)}
              />
            </section>
          )}

          <!-- Imagen después del Desafío -->
          {imagenDesafio && urlDesafio && (
            <div
              class="gallery-card group relative w-full rounded-2xl sm:rounded-3xl overflow-hidden border border-gray-200/90 shadow-sm bg-gray-50 flex items-center justify-center transition-all duration-300 hover:shadow-lg hover:border-orange-400 cursor-zoom-in my-4 sm:my-6"
              style={aspectRatioDesafio}
              data-lightbox-src={urlDesafio}
              data-lightbox-type={isVideoDesafio ? 'video' : 'image'}
              data-lightbox-alt={imagenDesafio?.alternativeText || `Captura del desafío de ${proyecto.titulo}`}
            >
              {isVideoDesafio ? (
                <div class="relative w-full h-full flex items-center justify-center bg-black">
                  <video
                    src={urlDesafio}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-md text-white px-2.5 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 pointer-events-none shadow-sm">
                    <svg class="w-3.5 h-3.5 fill-current text-orange-500" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                    <span>Video</span>
                  </div>
                </div>
              ) : (
                <img
                  src={urlDesafio}
                  alt={imagenDesafio?.alternativeText || `Captura del desafío de ${proyecto.titulo}`}
