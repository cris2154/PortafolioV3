            <div
              class="gallery-card group relative w-full rounded-2xl sm:rounded-3xl overflow-hidden border border-gray-200/90 shadow-sm bg-gray-50 flex items-center justify-center transition-all duration-300 hover:shadow-lg hover:border-orange-400 cursor-zoom-in my-4 sm:my-6"
              style={aspectRatioSolucion}
              data-lightbox-src={urlSolucion}
              data-lightbox-type={isVideoSolucion ? 'video' : 'image'}
              data-lightbox-alt={imagenSolucion?.alternativeText || `Captura de la solución de ${proyecto.titulo}`}
            >
              {isVideoSolucion ? (
                <div class="relative w-full h-full flex items-center justify-center bg-black">
                  <video
                    src={urlSolucion}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-md text-white px-2.5 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 pointer-events-none shadow-sm">
                    <svg class="w-3.5 h-3.5 fill-current text-orange-500" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                    <span>Video</span>
                  </div>
                </div>
              ) : (
                <img
                  src={urlSolucion}
                  alt={imagenSolucion?.alternativeText || `Captura de la solución de ${proyecto.titulo}`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              )}

              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/15 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100 pointer-events-none">
                <span class="w-10 h-10 rounded-full bg-white/90 backdrop-blur-md text-gray-900 flex items-center justify-center shadow-md transform scale-75 group-hover:scale-100 transition-transform">
                  <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                  </svg>
                </span>
              </div>
            </div>
          )}

          <!-- Métricas de Impacto -->
          {proyecto.metricas_impacto && proyecto.metricas_impacto.length > 0 && (
            <section class="max-w-2xl mx-auto w-full space-y-4 pt-4">
              <h2 class="text-xs uppercase tracking-widest font-bold text-gray-400">
                Impacto y Resultados
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                {proyecto.metricas_impacto.map((metrica) => (
                  <div class="bg-gray-50 rounded-2xl p-5 border border-gray-200/80 flex flex-col justify-center">
                    <span class="text-3xl sm:text-4xl font-black text-orange-600 mb-1">
                      {metrica.valor}
                    </span>
                    <span class="text-sm sm:text-base text-gray-700 font-medium">
                      {metrica.descripcion}
                    </span>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Características Clave -->
          {proyecto.caracteristicas_clave && proyecto.caracteristicas_clave.length > 0 && (
            <section class="max-w-2xl mx-auto w-full space-y-4 pt-4">
              <h2 class="text-xs uppercase tracking-widest font-bold text-gray-400">
                Características Principales
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                {proyecto.caracteristicas_clave.map((caract) => (
                  <div class="p-5 rounded-2xl border border-gray-200/80 bg-gray-50/80 shadow-xs">
                    <h3 class="font-bold text-gray-900 text-base sm:text-lg mb-1.5">
                      {caract.titulo}
                    </h3>
                    <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
                      {caract.descripcion}
                    </p>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Todo el Stack de Tecnologías Usadas -->
          {proyecto.tecnologias && proyecto.tecnologias.length > 0 && (
            <section class="max-w-2xl mx-auto w-full space-y-4 pt-4">
              <h2 class="text-xs uppercase tracking-widest font-bold text-gray-400">
                Tecnologías y Herramientas Utilizadas
              </h2>
              <div class="flex flex-wrap gap-2.5 sm:gap-3">
                {proyecto.tecnologias.map((tec) => (
                  <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-medium bg-gray-50 border border-gray-200/90 text-gray-700 shadow-2xs hover:border-orange-300 hover:bg-orange-50/50 transition-colors">
                    {tec.nombre}
                  </span>
                ))}
              </div>
            </section>
          )}

          <!-- Galería / Otras Imágenes del Proyecto (si hay más de 2) -->
          {galeriaRestante.length > 0 && (
            <section class="pt-8">
              <div class="max-w-2xl mx-auto w-full mb-6">
                <h2 class="text-xs uppercase tracking-widest font-bold text-gray-400">
                  Otras Imágenes del Proyecto
                </h2>
              </div>
              <div class="gallery-container flex flex-wrap justify-center gap-4 sm:gap-6">
                {galeriaRestante.map((img: any, idx: number) => {
                  const url = getMediaUrl(img);
                  if (!url) return null;
                  const isImgVideo =
                    img?.mime?.startsWith('video/') ||
                    /\.(mp4|webm|ogg|mov)$/i.test(url);
                  const total = galeriaRestante.length;

                  // Distribución en forma de pirámide según la cantidad de elementos
                  let widthClass = 'w-full sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)]';
                  if (total === 5) {
                    widthClass = idx < 2
                      ? 'w-full sm:w-[calc(50%-12px)] md:w-[calc(50%-16px)]'
                      : 'w-full sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)]';
                  } else if (total === 4) {
                    widthClass = 'w-full sm:w-[calc(50%-12px)] md:w-[calc(50%-16px)]';
                  } else if (total === 3) {
                    widthClass = idx === 0
                      ? 'w-full md:w-[calc(60%-16px)]'
                      : 'w-full sm:w-[calc(50%-12px)] md:w-[calc(48%-16px)]';
                  } else if (total === 2) {
                    widthClass = 'w-full sm:w-[calc(50%-12px)] md:w-[calc(50%-16px)]';
                  } else if (total === 1) {
                    widthClass = 'w-full max-w-2xl';
                  }

                  const aspectRatioStyle =
                    img?.width && img?.height
                      ? `aspect-ratio: ${img.width} / ${img.height};`
                      : 'aspect-ratio: 16 / 9;';

                  return (
                    <div
                      class={`gallery-card group relative rounded-2xl overflow-hidden border border-gray-200/90 shadow-sm bg-gray-50 flex items-center justify-center transition-all duration-300 hover:shadow-lg hover:border-orange-400 cursor-zoom-in ${widthClass}`}
                      style={aspectRatioStyle}
                      data-lightbox-src={url}
                      data-lightbox-type={isImgVideo ? 'video' : 'image'}
                      data-lightbox-alt={img?.alternativeText || `Captura ${idx + 1} de ${proyecto.titulo}`}
                    >
                      {isImgVideo ? (
                        <div class="relative w-full h-full flex items-center justify-center bg-black">
                          <video
                            src={url}
                            autoplay
                            loop
                            muted
                            playsinline
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          />
                          <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-md text-white px-2.5 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 pointer-events-none shadow-sm">
                            <svg class="w-3.5 h-3.5 fill-current text-orange-500" viewBox="0 0 24 24">
                              <path d="M8 5v14l11-7z" />
                            </svg>
                            <span>Video</span>
                          </div>
                        </div>
                      ) : (
                        <img
                          src={url}
                          alt={img?.alternativeText || `Captura ${idx + 1} de ${proyecto.titulo}`}
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          loading="lazy"
                        />
                      )}

                      <!-- Indicador de zoom / click para ver a tamaño completo -->
                      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/15 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100 pointer-events-none">
                        <span class="w-10 h-10 rounded-full bg-white/90 backdrop-blur-md text-gray-900 flex items-center justify-center shadow-md transform scale-75 group-hover:scale-100 transition-transform">
                          <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                          </svg>
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          <!-- Botón inferior para regresar -->
          <div class="max-w-2xl mx-auto w-full pt-8 pb-12 flex justify-center">
            <button
              type="button"
              class="close-modal-trigger inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-gray-900 hover:bg-orange-500 text-white font-semibold text-sm transition-all hover:scale-105 active:scale-95 shadow-md cursor-pointer group"
            >
              <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span>Volver a trabajos</span>
            </button>
          </div>

        </main>
      </div>
    );
  })}

  <!-- LIGHTBOX MODAL PARA IMÁGENES Y VIDEOS A TAMAÑO COMPLETO -->
  <div
    id="work-lightbox"
    class="fixed inset-0 z-[200] bg-black/92 backdrop-blur-md flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Visor multimedia a tamaño completo"
  >
    <button
      type="button"
      id="close-work-lightbox-btn"
      class="absolute top-5 right-5 z-20 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors cursor-pointer"
      aria-label="Cerrar visor"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div id="work-lightbox-content" class="max-w-5xl max-h-[88vh] w-full flex items-center justify-center"></div>
  </div>
</section>

<style>
  /* Mobile: recto y limpio, sin corte diagonal que rompa la imagen o desalinee */
  .work-media-layer {
    clip-path: none;
  }

  /* Desktop */
  @media (min-width: 768px) {
    /* Estado NORMAL (sin hover): cubre el 100% de la tarjeta */
    .work-media-layer {
      width: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    }

    /* Estado EN HOVER: se contrae a la mitad con el corte diagonal de 120° */
    .work-card:hover .work-media-layer {
      width: 53%;
      clip-path: polygon(0 0, 100% 0, calc(100% - 80px) 100%, 0 100%);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const workContainer = document.querySelector(".work-container");
  if (workContainer) {
    gsap.from(".work-container", {
      scrollTrigger: {
        trigger: "#work",
        start: "top 88%",
        once: true,
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
      clearProps: "all",
    });

    gsap.from(".work-card", {
      scrollTrigger: {
        trigger: ".work-list",
        start: "top 90%",
        once: true,
      },
      y: 20,
      opacity: 0,
      stagger: 0.12,
      duration: 0.5,
      ease: "power2.out",
      clearProps: "all",
    });
  }

  // Interacción de Modales (abrir / cerrar tipo página con animaciones GSAP)
  const cardTriggers = document.querySelectorAll('.work-card');
  const openButtons = document.querySelectorAll('.work-card .open-modal-trigger');
  const closeButtons = document.querySelectorAll('.work-modal .close-modal-trigger');
  const modals = document.querySelectorAll('.work-modal');

  const openModal = (modal: HTMLElement) => {
    modal.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
    modal.scrollTop = 0;
    document.body.style.overflow = 'hidden';

    // Animación de entrada de la barra superior
    const header = modal.querySelector('header');
    if (header) {
      gsap.fromTo(
        header,
        { y: -24, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.35, ease: 'power2.out' }
      );
    }

    // Animación escalonada de las secciones de contenido
    const mainElements = modal.querySelectorAll('main > *');
    if (mainElements.length > 0) {
      gsap.fromTo(
        mainElements,
        { y: 28, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.45, stagger: 0.08, ease: 'power3.out', delay: 0.05 }
      );
    }

    // Animación de aparición de las tarjetas de la galería
    const galleryItems = modal.querySelectorAll('.gallery-card');
    if (galleryItems.length > 0) {
      gsap.fromTo(
        galleryItems,
        { scale: 0.92, opacity: 0, y: 15 },
        { scale: 1, opacity: 1, y: 0, duration: 0.4, stagger: 0.06, ease: 'back.out(1.2)', delay: 0.3 }
      );
    }
  };

  const closeModal = (modal: HTMLElement) => {
    gsap.to(modal, {
      opacity: 0,
      duration: 0.22,
      ease: 'power2.in',
      onComplete: () => {
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('hidden', 'opacity-0', 'pointer-events-none');
        gsap.set(modal, { clearProps: 'opacity' });
        document.body.style.overflow = '';
      },
    });
  };

  cardTriggers.forEach((card) => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a') || target.closest('button')) return;
      const targetId = (card as HTMLElement).dataset.modalTarget;
      if (!targetId) return;
      const modal = document.getElementById(targetId);
      if (modal) openModal(modal);
    });
  });

  openButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = (btn as HTMLElement).dataset.modalTarget;
      if (!targetId) return;
      const modal = document.getElementById(targetId);
      if (modal) openModal(modal);
    });
  });

  closeButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const modal = btn.closest<HTMLElement>('.work-modal');
      if (modal) closeModal(modal);
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('.modal-nav-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      const modal = link.closest<HTMLElement>('.work-modal');
      if (modal) closeModal(modal);
      if (href && href.startsWith('#')) {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth' });
          }, 240);
        }
      }
    });
  });

  modals.forEach((modal) => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal(modal as HTMLElement);
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modals.forEach((modal) => closeModal(modal as HTMLElement));
    }
  });

  // Lightbox interactivo para ver imágenes y videos de proyectos en tamaño completo
  const workLightbox = document.getElementById('work-lightbox');
  const workLightboxContent = document.getElementById('work-lightbox-content');
  const closeWorkLightboxBtn = document.getElementById('close-work-lightbox-btn');
  const workGalleryCards = document.querySelectorAll('.work-modal .gallery-card');

  const openWorkLightbox = (src: string, type: string, alt: string) => {
    if (!workLightbox || !workLightboxContent) return;
    if (type === 'video') {
      workLightboxContent.innerHTML = `
        <video
          src="${src}"
          controls
          autoplay
          playsinline
          class="max-w-full max-h-[85vh] w-auto h-auto rounded-2xl shadow-2xl object-contain bg-black"
        ></video>
      `;
    } else {
      workLightboxContent.innerHTML = `
        <img
          src="${src}"
          alt="${alt}"
          class="max-w-full max-h-[85vh] w-auto h-auto rounded-2xl shadow-2xl object-contain"
        />
      `;
    }
    workLightbox.classList.remove('opacity-0', 'pointer-events-none');
    workLightbox.classList.add('opacity-100', 'pointer-events-auto');
  };

  const closeWorkLightbox = () => {
    if (!workLightbox || !workLightboxContent) return;
    const video = workLightboxContent.querySelector('video');
    if (video) video.pause();
    workLightbox.classList.remove('opacity-100', 'pointer-events-auto');
    workLightbox.classList.add('opacity-0', 'pointer-events-none');
    setTimeout(() => {
      workLightboxContent.innerHTML = '';
    }, 300);
  };

  workGalleryCards.forEach((card) => {
    card.addEventListener('click', (e) => {
      e.stopPropagation();
      const target = card as HTMLElement;
      const src = target.dataset.lightboxSrc;
      const type = target.dataset.lightboxType || 'image';
      const alt = target.dataset.lightboxAlt || '';
      if (src) openWorkLightbox(src, type, alt);
    });
  });

  if (closeWorkLightboxBtn) {
    closeWorkLightboxBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeWorkLightbox();
    });
  }

  if (workLightbox) {
    workLightbox.addEventListener('click', (e) => {
      if (e.target === workLightbox || e.target === workLightboxContent) {
        closeWorkLightbox();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && workLightbox && !workLightbox.classList.contains('opacity-0')) {
      closeWorkLightbox();
    }
  });
</script>
