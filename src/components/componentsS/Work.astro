---
import type { Proyecto } from '../../service';
import { getConfiguracionGlobal, getProyectos, getMediaUrl } from '../../service';
import { humanize, markdownLite } from '../../utils/text';

interface Props {
  proyectos?: Proyecto[];
}

const { proyectos: propProyectos } = Astro.props;
let proyectos: Proyecto[] = [];

if (Array.isArray(propProyectos) && propProyectos.length > 0) {
  proyectos = propProyectos;
} else {
  try {
    proyectos = await getProyectos();
  } catch (e) {
    console.error('Error cargando proyectos:', e);
    proyectos = [];
  }
}

const config = await getConfiguracionGlobal().catch(() => null);
const correo = config?.correo_contacto || 'Crishuamani023@gmail.com';
const redes = config?.redes_sociales ?? [];
const instagram = redes.find((r) => r.red === 'instagran' || r.red === 'instagram')?.url || 'https://www.instagram.com';
const nombre =
  config?.nombre_sitio && config.nombre_sitio !== 'Portafolio Dev (datos de prueba)'
    ? config.nombre_sitio
    : 'Cristhian Huamani';
---

<section
  id="work"
  class="w-full bg-white text-gray-900 py-16 sm:py-20 lg:py-24 relative overflow-hidden"
>
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- CONTENEDOR GRANDE (IGUAL QUE HERO, ABOUT Y EXPERIENCIA) -->
    <div
      class="work-container w-full bg-white rounded-3xl lg:rounded-[36px] border border-gray-100 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.06),0_1px_3px_rgba(0,0,0,0.02)] p-6 sm:p-10 lg:p-12 xl:p-14 relative"
    >
      
      <!-- Encabezado de la Sección -->
      <div class="work-header mb-10 sm:mb-12">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900">
          Trabajos Recientes
        </h2>
        <p class="text-gray-500 text-base sm:text-lg max-w-2xl mt-3 leading-relaxed">
          Selección de aplicaciones web, proyectos de software y plataformas desarrolladas.
        </p>
      </div>

      {proyectos.length === 0 && (
        <p class="text-center text-gray-400 py-12">Pronto habrá proyectos para mostrar.</p>
      )}

      <!-- Lista de Trabajos -->
      <div class="work-list space-y-6 sm:space-y-8">
        {proyectos.map((proyecto) => {
          const mediaUrl = getMediaUrl(proyecto.imagen_portada);
          const isVideo = proyecto.imagen_portada?.mime?.startsWith('video/') ?? false;
          const initials = proyecto.titulo
            ? proyecto.titulo.trim().split(/\s+/).slice(0, 2).map((w: string) => w[0]).join('').toUpperCase()
            : 'PR';

          return (
            <article
              class="work-card bg-white rounded-3xl border border-gray-100 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.06),0_1px_3px_rgba(0,0,0,0.02)] overflow-hidden transition-all duration-500 hover:shadow-2xl relative group cursor-pointer min-h-[380px] md:min-h-[350px] flex flex-col md:flex-row items-stretch"
              data-modal-target={`modal-work-${proyecto.id}`}
            >
              
              <!-- CAPA 1: IMAGEN / VIDEO / PORTADA -->
              <!-- En desktop sin hover: cubre el 100% de la card. Con hover: se retrae al 53% con corte de 120° -->
              <div class="work-media-layer w-full md:absolute md:inset-y-0 md:left-0 h-64 md:h-full z-10 overflow-hidden flex items-center justify-center transition-all duration-500 ease-out bg-gray-100">
                {isVideo ? (
                  <video
                    src={mediaUrl}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                ) : mediaUrl ? (
                  <img
                    src={mediaUrl}
                    alt={proyecto.imagen_portada?.alternativeText ?? `Portada de ${proyecto.titulo}`}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full min-h-[260px] bg-gradient-to-br from-orange-500 via-amber-500 to-orange-600 flex items-center justify-center text-white p-8 relative overflow-hidden">
                    <div class="absolute w-72 h-72 bg-white/10 rounded-full blur-2xl pointer-events-none group-hover:scale-125 transition-transform duration-700"></div>
                    <div class="flex flex-col items-center justify-center relative z-10 transition-transform duration-500 md:group-hover:-translate-x-4">
                      <span class="text-6xl sm:text-7xl font-black tracking-tight drop-shadow-sm transition-transform duration-300 group-hover:scale-105">
                        {initials}
                      </span>
                      <span class="text-base sm:text-lg font-bold text-white/90 mt-3 tracking-wide text-center">
                        {proyecto.titulo}
                      </span>
                    </div>
                  </div>
                )}

                <!-- NOMBRE EN GRIS MEDIO TRANSPARENTE EN EL MEDIO TIRANDO PARA LA DERECHA (END) - OCULTO EN MÓVILES -->
                <div class="watermark-overlay absolute inset-y-0 right-0 w-full sm:w-2/3 hidden md:flex items-center justify-end pr-8 sm:pr-12 md:pr-16 text-right pointer-events-none transition-all duration-500 ease-out group-hover:opacity-0 group-hover:translate-x-6 z-20">
                  <div class="flex flex-col items-end max-w-sm">
                    <span class="text-3xl sm:text-5xl md:text-6xl font-black text-gray-900/20 sm:text-gray-900/25 tracking-tighter uppercase leading-none select-none text-right line-clamp-2">
                      {proyecto.titulo}
                    </span>
                    <span class="text-xs sm:text-sm font-bold text-gray-900/30 mt-2.5 tracking-widest uppercase">
                      {humanize(proyecto.estado)}
                    </span>
                  </div>
                </div>
              </div>

              <!-- CAPA 2: DETALLES DEL PROYECTO (LADO DERECHO) -->
              <!-- En desktop: ocupa la mitad derecha. Solo estado/cliente, título, lema, tecnologías y botón Ver más -->
              <div class="work-details-layer w-full md:w-1/2 md:ml-auto p-5 sm:p-8 lg:p-10 md:pl-12 lg:pl-16 flex flex-col justify-center space-y-3.5 sm:space-y-4 relative z-10 transition-all duration-500 ease-out max-md:opacity-100 md:opacity-0 md:translate-x-6 md:group-hover:opacity-100 md:group-hover:translate-x-0">
                
                <!-- Estado / Rol o Cliente -->
                <div class="flex items-center justify-between gap-2 w-full">
                  <div class="flex items-center gap-1.5 min-w-0 flex-1 text-xs sm:text-sm font-semibold text-gray-500 tracking-wide">
                    {proyecto.cliente_o_contexto ? (
                      <>
                        <svg class="w-4 h-4 text-orange-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                        <span class="truncate">{proyecto.cliente_o_contexto}</span>
                      </>
                    ) : (
                      <span class="uppercase tracking-wider text-xs font-semibold text-gray-500 truncate">
                        {humanize(proyecto.estado)}
                      </span>
                    )}
                  </div>
                  
                  {proyecto.destacado && (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-50 text-orange-700 border border-orange-200/80 shrink-0 whitespace-nowrap">
                      <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
                      Destacado
                    </span>
                  )}
                </div>

                <!-- Título y Lema -->
                <div>
                  <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors tracking-tight">
                    {proyecto.titulo}
                  </h3>
                  {proyecto.lema && (
                    <p class="text-base font-semibold text-gray-600 mt-1 line-clamp-2">
                      {proyecto.lema}
                    </p>
                  )}
                </div>

                <!-- Tecnologías utilizadas (pills) -->
                {proyecto.tecnologias && proyecto.tecnologias.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {proyecto.tecnologias.slice(0, 4).map((tec) => (
                      <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 font-medium">
                        {tec.nombre}
                      </span>
                    ))}
                    {proyecto.tecnologias.length > 4 && (
                      <span class="text-xs px-2 py-1 rounded-full bg-gray-50 text-gray-400 font-medium">
                        +{proyecto.tecnologias.length - 4}
                      </span>
                    )}
                  </div>
                )}

                <!-- Botón Ver más y Enlaces directos -->
                <div class="pt-2 flex flex-wrap items-center gap-3">
                  <button
                    type="button"
                    class="open-modal-trigger inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold shadow-md shadow-orange-500/20 transition-all hover:scale-105 active:scale-95 cursor-pointer"
                    data-modal-target={`modal-work-${proyecto.id}`}
                  >
                    <span>Ver más</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </button>

                  {proyecto.enlace_demo && (
                    <a
                      href={proyecto.enlace_demo}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs sm:text-sm font-medium transition-colors"
                      onclick="event.stopPropagation();"
                    >
                      <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                      <span>Demo</span>
                    </a>
                  )}

                  {proyecto.enlace_repositorio && (
                    <a
                      href={proyecto.enlace_repositorio}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs sm:text-sm font-medium transition-colors"
                      onclick="event.stopPropagation();"
                    >
                      <svg class="w-3.5 h-3.5 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                      </svg>
                      <span>Código</span>
                    </a>
                  )}
                </div>

              </div>

            </article>
          );
        })}
      </div>

    </div>

  </div>

  <!-- VISTAS DE DETALLE COMPLETO (PÁGINA COMPLETA CON SCROLL) -->
  {proyectos.map((proyecto) => {
    const mediaUrl = getMediaUrl(proyecto.imagen_portada);
    const isVideo = proyecto.imagen_portada?.mime?.startsWith('video/') ?? false;
    const initials = proyecto.titulo
      ? proyecto.titulo.trim().split(/\s+/).slice(0, 2).map((w: string) => w[0]).join('').toUpperCase()
      : 'PR';
    const galeria = (Array.isArray(proyecto.galeria)
      ? proyecto.galeria
      : proyecto.galeria
      ? [proyecto.galeria]
      : []) as any[];

    const imagenDesafio = galeria.length > 0 ? galeria[0] : null;
    const urlDesafio = imagenDesafio ? getMediaUrl(imagenDesafio) : null;
    const isVideoDesafio = imagenDesafio && (
      imagenDesafio.mime?.startsWith('video/') ||
      /\.(mp4|webm|ogg|mov)$/i.test(urlDesafio || '')
    );
    const aspectRatioDesafio = imagenDesafio?.width && imagenDesafio?.height
      ? `aspect-ratio: ${imagenDesafio.width} / ${imagenDesafio.height};`
      : 'aspect-ratio: 16 / 9;';

    const imagenSolucion = galeria.length > 1 ? galeria[1] : null;
    const urlSolucion = imagenSolucion ? getMediaUrl(imagenSolucion) : null;
    const isVideoSolucion = imagenSolucion && (
      imagenSolucion.mime?.startsWith('video/') ||
      /\.(mp4|webm|ogg|mov)$/i.test(urlSolucion || '')
    );
    const aspectRatioSolucion = imagenSolucion?.width && imagenSolucion?.height
      ? `aspect-ratio: ${imagenSolucion.width} / ${imagenSolucion.height};`
      : 'aspect-ratio: 16 / 9;';

    const galeriaRestante = galeria.slice(2);

    return (
      <div
        id={`modal-work-${proyecto.id}`}
        class="work-modal fixed inset-0 z-[100] w-full h-full min-h-screen bg-white overflow-y-auto hidden opacity-0 pointer-events-none transition-opacity duration-300"
        role="dialog"
        aria-modal="true"
        aria-labelledby={`modal-work-title-${proyecto.id}`}
      >
        <!-- Nav Flotante Fijo ("haciendo la finta" del Navbar principal) -->
        <header class="fixed top-5 left-1/2 -translate-x-1/2 w-[92%] max-w-4xl z-50">
          <nav class="nav-shell bg-white/95 backdrop-blur-md rounded-full shadow-[0_4px_25px_rgba(0,0,0,0.06)] px-5 sm:px-8 py-3 sm:py-3.5 flex items-center justify-between border border-gray-100 transition-all">
            
            <!-- LADO IZQUIERDO: Logo Sonriente + Nombre (Click para cerrar y volver al inicio) -->
            <button
              type="button"
              class="close-modal-trigger flex items-center gap-2.5 group cursor-pointer text-left focus:outline-none"
              aria-label="Cerrar y volver al inicio"
            >
              <span class="w-8 h-8 flex items-center justify-center text-orange-500 transition-transform group-hover:scale-110">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.5 13C3.8 9.5 5.5 6 9 6.5C10 4 14 4 15 6.5C18.5 6 20.2 9.5 19.5 13C18.5 18 15.5 20 12 20C8.5 20 5.5 18 4.5 13Z" />
                  <path d="M8.8 11.8C9.3 11.2 10.1 11.2 10.6 11.8" />
                  <path d="M13.4 11.8C13.9 11.2 14.7 11.2 15.2 11.8" />
                  <path d="M9.8 15.2C10.8 16.5 13.2 16.5 14.2 15.2" />
                </svg>
              </span>
              <span class="font-bold text-orange-500 text-base sm:text-lg tracking-tight group-hover:opacity-90">
                {nombre}
              </span>
            </button>

            <!-- CENTRO: Enlaces de navegación (cierran el modal y navegan a la sección) -->
            <div class="hidden md:flex items-center gap-6">
              <a href="#about" class="modal-nav-link text-sm font-medium text-gray-500 hover:text-orange-500 transition-colors">Sobre mí</a>
              <a href="#experience" class="modal-nav-link text-sm font-medium text-gray-500 hover:text-orange-500 transition-colors">Experiencia</a>
              <a href="#work" class="modal-nav-link text-sm font-medium text-gray-500 hover:text-orange-500 transition-colors">Trabajos</a>
              <a href="#hability" class="modal-nav-link text-sm font-medium text-gray-500 hover:text-orange-500 transition-colors">Habilidades</a>
              <a href="#final" class="modal-nav-link text-sm font-medium text-gray-500 hover:text-orange-500 transition-colors">Contacto</a>
            </div>

            <!-- LADO DERECHO: Modo oscuro + Ícono Instagram + Botón Cerrar X -->
            <div class="flex items-center gap-3 sm:gap-4">
              <!-- Botón de Modo Oscuro -->
              <button
                type="button"
                class="theme-toggle w-8 h-8 sm:w-9 sm:h-9 rounded-full flex items-center justify-center text-gray-600 hover:text-orange-500 hover:bg-orange-50/70 transition-all cursor-pointer"
                aria-label="Alternar modo oscuro"
                title="Modo oscuro"
              >
                <!-- Icono Luna (Modo claro) -->
                <svg class="w-5 h-5 moon-icon transition-transform hover:-rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <!-- Icono Sol (Modo oscuro) -->
                <svg class="w-5 h-5 sun-icon hidden transition-transform hover:rotate-45 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="5"/>
                  <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                </svg>
              </button>
              <a
                href={instagram}
                target="_blank"
                rel="noreferrer"
                class="hidden sm:flex w-6 h-6 items-center justify-center text-gray-700 hover:text-orange-500 transition-transform hover:scale-110"
                aria-label="Instagram"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
              </a>
              <button
                type="button"
                class="close-modal-trigger w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-gray-100 hover:bg-orange-50 hover:text-orange-600 text-gray-700 flex items-center justify-center transition-colors cursor-pointer"
                aria-label="Cerrar vista completa"
              >
                <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

          </nav>
        </header>

        <!-- Contenedor Central con Todo el Contexto del Proyecto y Scroll Completo -->
        <main class="w-full max-w-4xl mx-auto px-5 sm:px-8 pt-24 sm:pt-28 pb-16 space-y-10">
          
          <!-- Botón de Volver (más abajo, encima del contenido) -->
          <div class="max-w-2xl mx-auto w-full">
            <button
              type="button"
              class="close-modal-trigger inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-orange-600 transition-all cursor-pointer py-2 px-4 rounded-full bg-gray-50 hover:bg-orange-50 border border-gray-200/90 hover:border-orange-200 group shadow-2xs hover:shadow-xs"
            >
              <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1 text-gray-500 group-hover:text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              <span>Volver a trabajos</span>
            </button>
          </div>
          
          <!-- Portada / Imagen o Video del Proyecto (Sin contenedor, más grande, centrado y con rounded-2xl) -->
          <div class="flex justify-center w-full">
            {isVideo ? (
              <video
                src={mediaUrl}
                autoplay
                loop
                muted
                playsinline
                class="w-full max-w-2xl h-auto max-h-72 sm:max-h-84 object-cover rounded-2xl shadow-sm"
              />
            ) : mediaUrl ? (
              <img
                src={mediaUrl}
                alt={proyecto.imagen_portada?.alternativeText ?? `Portada de ${proyecto.titulo}`}
                class="w-full max-w-2xl h-auto max-h-72 sm:max-h-84 object-cover rounded-2xl shadow-sm"
              />
            ) : (
              <div class="w-full max-w-2xl h-56 sm:h-72 bg-gradient-to-br from-orange-500 via-amber-500 to-orange-600 rounded-2xl shadow-sm flex flex-col items-center justify-center text-white p-6 text-center">
                <span class="text-5xl sm:text-6xl font-black drop-shadow-sm">
                  {initials}
                </span>
                <span class="text-lg sm:text-xl font-bold mt-2 text-white/95">
                  {proyecto.titulo}
                </span>
              </div>
            )}
          </div>

          <!-- Encabezado: Badges, Título, Lema, Contexto y Enlaces -->
          <div class="space-y-4 max-w-2xl mx-auto w-full">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                {humanize(proyecto.estado)}
              </span>
              {proyecto.destacado && (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-orange-50 text-orange-700 border border-orange-200">
                  <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
                  Destacado
                </span>
              )}
              {proyecto.rol_desempenado && (
                <span class="px-3 py-1 rounded-full text-xs font-medium bg-orange-50 text-orange-700 border border-orange-200/80">
                  Rol: {proyecto.rol_desempenado}
                </span>
              )}
              {proyecto.duracion && (
                <span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                  {proyecto.duracion}
                </span>
              )}
            </div>

            <h1 id={`modal-work-title-${proyecto.id}`} class="text-3xl sm:text-4xl md:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              {proyecto.titulo}
            </h1>

            {proyecto.lema && (
